# NEXO U - plantilla pública, SIN contraseñas ni tokens reales.
# Haz una copia llamada .env y edita SOLO ese archivo. No lo subas a Git.
# Usa la cadena de conexión de la rama de Neon que quieras probar.
DATABASE_URL=postgresql+psycopg://USUARIO:CAMBIAR_CONTRASENA@HOST-POOLER/neondb?sslmode=require&channel_binding=require

# Genera JWT_SECRET con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REEMPLAZA_POR_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# React/Vite local. Para Vercel añade el origen https://... del frontend.
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=false
ENVIRONMENT=development
ALLOW_DEMO_SEED=false
DEMO_EMITTER_KEY=no_activar_en_produccion

# IA generativa opcional: no se utiliza para decidir becas o elegibilidad.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
