# Copia a backend/.env (nunca subir a Git).
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@TU_HOST_POOLER/neondb?sslmode=require
# URL sin -pooler para ejecutar Alembic. No se usa para peticiones HTTP.
DATABASE_URL_UNPOOLED=
JWT_SECRET=REEMPLAZA_POR_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173
PUBLIC_FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
ALLOW_DEMO_SEED=false
DEMO_EMITTER_KEY=no_usar_en_produccion
# Recuperación por correo: opcional. Sin SMTP responde 503; no genera enlaces públicos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# IA generativa opcional, no decide elegibilidad.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
